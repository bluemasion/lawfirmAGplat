FROM python:3.8-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY agentic_on_arch/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY agentic_on_arch/ /app/

# Create data directories
RUN mkdir -p /app/data/materials /app/data/tasks /app/data/bidding \
    /app/data/company /app/uploads /app/templates

# Default env
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
